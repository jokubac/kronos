<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for macOS.
     cp deploy/com.kronos.daemon.plist ~/Library/LaunchAgents/
     edit the two paths below, then: launchctl load -w ~/Library/LaunchAgents/com.kronos.daemon.plist
     logs: ~/.kronos/logs/daemon.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kronos.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/CHANGE_ME/.local/bin/uv</string>
    <string>run</string>
    <string>kronos</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/CHANGE_ME/kronos</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/kronos.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/kronos.err.log</string>
</dict>
</plist>
