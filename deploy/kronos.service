# systemd user service for the Kronos daemon (Linux).
#   mkdir -p ~/.config/systemd/user && cp deploy/kronos.service ~/.config/systemd/user/
#   edit WorkingDirectory below, then:
#   systemctl --user daemon-reload && systemctl --user enable --now kronos
#   journalctl --user -u kronos -f
# For the daemon to run while you are logged out: loginctl enable-linger $USER
[Unit]
Description=Kronos / Jarvis daemon (scheduled calls, reminders, routines)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/kronos
ExecStart=%h/.local/bin/uv run kronos serve
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
