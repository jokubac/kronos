# Copy to .env and fill in. The Kronos CLI loads this file from the current directory.

# --- Anthropic ---------------------------------------------------------------
# Leave empty if you logged in with `ant auth login`: the SDK and `ant` share that profile.
# ANTHROPIC_API_KEY=sk-ant-...
# Console workspace slug/ID for session links (default workspace: "default").
# KRONOS_WORKSPACE=default

# --- Resource IDs ------------------------------------------------------------------
# Normally read from claude-lock.json (written by `ant apply`). Override only if needed.
# KRONOS_AGENT_ID=agent_...
# KRONOS_ENV_ID=env_...
# KRONOS_MEMORY_STORE_ID=memstore_...
# KRONOS_VAULT_ID=vlt_...
# KRONOS_LOCKFILE=/path/to/claude-lock.json

# --- Behaviour ---------------------------------------------------------------------
# Hard spend cap per session in USD (list prices, runs and subagents included). "off" disables it.
KRONOS_SESSION_BUDGET_USD=10
# What the Home agent's local_shell tool may do on this machine: ask (default) | deny | allow
KRONOS_SHELL_POLICY=ask
# Language hint for Jarvis (it replies in the language you write in anyway).
KRONOS_LANGUAGE=lt
# Where the last session ID is remembered (default ~/.kronos).
# KRONOS_STATE_DIR=~/.kronos

# --- Home Assistant (used by the Home agent through your machine) --------------------
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=eyJ...   # Profile -> Security -> Long-lived access tokens
